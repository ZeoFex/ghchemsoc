generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// =======================
// AUTH / ADMIN
// =======================
//

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

//
// =======================
// MEDIA LIBRARY (REUSABLE)
// =======================
//

model Media {
  id        String   @id @default(cuid())
  url       String
  publicId  String?
  alt       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  heroSlides HeroSlide[]
  aboutSections AboutSection[]
  executives Executive[]
  joinSteps JoinStep[]
  joinHeader JoinPageHeader[]
  newsItems NewsItem[]
  publications Publication[]
  societyEvents SocietyEvent[]
  testimonials Testimonial[]
  homepageExploreMainImage HomepageExploreSettings? @relation("HomepageExploreMainImage")
  homepageExploreSecondaryImage HomepageExploreSettings? @relation("HomepageExploreSecondaryImage")
  homepageEventsSpotlightImage HomepageEventsSettings? @relation("HomepageEventsSpotlightImage")
  partnershipCards PartnershipCard[]
  societyResources SocietyResource[]
  siteFooterLeftImage SiteFooterSettings? @relation("SiteFooterLeftImage")
  siteFooterRightImage SiteFooterSettings? @relation("SiteFooterRightImage")
}

//
// =======================
// HOMEPAGE · PARTNERSHIPS
// =======================
//

model HomepagePartnershipsSettings {
  id String @id @default("homepage_partnerships")

  eyebrow            String  @default("Partnerships")
  title              String  @default("Our partners")
  searchPlaceholder  String  @default("Search partners…")
  showSearch         Boolean @default(true)
  ctaLabel           String  @default("View all")
  ctaHref            String  @default("/contact")
  footerNote         String? @db.Text

  updatedAt DateTime @updatedAt
}

model PartnershipCard {
  id        String  @id @default(cuid())
  published Boolean @default(true)
  sortOrder Int     @default(0)

  tag        String
  title      String
  accentPill String?
  href       String?

  mediaId String?
  media   Media? @relation(fields: [mediaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([sortOrder])
}

//
// =======================
// EVENTS (CONFERENCES & MEETINGS)
// =======================
//

model SocietyEvent {
  id        String   @id @default(cuid())
  featured  Boolean  @default(false)
  published Boolean  @default(true)
  sortOrder Int      @default(0)

  title     String
  excerpt   String
  /// Optional longer copy for the public event detail page (/events/[id]).
  body      String?
  startDate DateTime
  endDate   DateTime?
  timeLabel String
  location  String
  href      String?
  badge     String?

  /// JSON array of field definitions for the public registration form (see lib/event-registration-form.ts).
  /// Each field: { id, label, type, required?, options?, description?, placeholder?, accept?, sortOrder? }
  /// Types: short_text, long_text, email, tel, number, date, dropdown, radio, checkbox, multi_select, file, section, paragraph
  registrationFormFields Json?

  mediaId String?
  media   Media? @relation(fields: [mediaId], references: [id])

  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([featured])
  @@index([sortOrder])
  @@index([startDate])
}

model EventRegistration {
  id          String   @id @default(cuid())
  eventId     String
  event       SocietyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Answers keyed by field `id` from registrationFormFields (string or string[] for multi-select fields).
  responses   Json
  /// Short line for inbox lists (e.g. name · email).
  summaryLine String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([eventId])
  @@index([createdAt])
  @@index([read])
}

//
// =======================
// CONTACT PAGE (SINGLETON)
// =======================
//

model ContactSettings {
  id String @id @default("contact")

  eyebrow  String @default("Contact")
  headline String
  subtext  String

  /// JSON array: { "icon": "phone"|"mail"|"map"|"clock", "title", "value", "description" }
  cards Json @default("[]")

  updatedAt DateTime @updatedAt
}

/// Public contact form submissions (visible to admins in CMS).
model ContactInquiry {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([read])
}

//
// =======================
// SITE FOOTER (SINGLETON)
// =======================
//

model SiteFooterSettings {
  id String @id @default("site_footer")

  headlineLine1 String
  headlineLine2 String
  helplineText  String
  description   String @db.Text
  copyrightText String

  /// Link label for trademark / legal (e.g. "Trademark policy").
  trademarkLabel String @default("Trademark & legal")
  /// URL for trademark page or PDF.
  trademarkHref  String @default("/contact")
  /// Optional line under copyright (® notice, etc.).
  trademarkNotice String? @db.Text

  /// JSON: [{ "label", "href" }]
  navLinks Json @default("[]")
  /// JSON: [{ "platform": "linkedin"|…, "href", "label"? }]
  socialLinks Json @default("[]")

  leftImageMediaId String? @unique
  leftImageMedia   Media?  @relation("SiteFooterLeftImage", fields: [leftImageMediaId], references: [id])

  rightImageMediaId String? @unique
  rightImageMedia   Media?  @relation("SiteFooterRightImage", fields: [rightImageMediaId], references: [id])

  updatedAt DateTime @updatedAt
}

//
// =======================
// HOMEPAGE · EXPLORE / MISSION STRIP
// =======================
//

model HomepageExploreSettings {
  id String @id @default("homepage_explore")

  missionEyebrow String
  headlineLine1  String
  headlineLine2  String

  aboutEyebrow String
  aboutBody    String @db.Text

  imageBadge      String
  imageHoverQuote String @db.Text
  locationLabel   String

  secondaryBadge String
  bottomBlurb    String @db.Text

  mainImageMediaId String? @unique
  mainImageMedia   Media? @relation("HomepageExploreMainImage", fields: [mainImageMediaId], references: [id])

  secondaryImageMediaId String? @unique
  secondaryImageMedia   Media? @relation("HomepageExploreSecondaryImage", fields: [secondaryImageMediaId], references: [id])

  updatedAt DateTime @updatedAt
}

//
// =======================
// HOMEPAGE · EVENTS STRIP
// =======================
//

model HomepageEventsSettings {
  id String @id @default("homepage_events")

  /// Show the spotlight block on the homepage.
  spotlightEnabled Boolean @default(true)

  sectionEyebrow String @default("Upcoming")
  sectionTitle   String @default("Conferences & events")

  spotlightEyebrow String
  headline         String
  body             String @db.Text
  metaLine         String?

  /// "left" | "right" — image column on large screens.
  imagePosition String @default("left")

  ctaLabel String
  ctaHref  String

  imageBadge String?

  imageMediaId String? @unique
  imageMedia   Media? @relation("HomepageEventsSpotlightImage", fields: [imageMediaId], references: [id])

  updatedAt DateTime @updatedAt
}

//
// =======================
// HERO SECTION
// =======================
//

model HeroSlide {
  id        String  @id @default(cuid())
  sortOrder Int     @default(0)
  published Boolean @default(true)

  mediaId   String?
  media     Media?  @relation(fields: [mediaId], references: [id])

  imageAlt  String

  eyebrow       String
  headlineLine1 String
  headlineLine2 String
  description   String

  tags       Json @default("[]")
  highlights Json @default("[]")

  ctaLabel      String
  ctaHref       String
  secondaryLabel String?
  secondaryHref  String?

  statValue String?
  statLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([sortOrder])
}

//
// =======================
// ABOUT PAGE
// =======================
//

model AboutSection {
  id        String  @id @default(cuid())
  sortOrder Int     @default(0)
  published Boolean @default(true)

  title    String
  subtitle String?
  body     String

  layout   String @default("default")

  mediaId  String?
  media    Media? @relation(fields: [mediaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([sortOrder])
}

model Executive {
  id        String  @id @default(cuid())
  sortOrder Int     @default(0)
  published Boolean @default(true)

  name String
  role String
  bio  String? @db.Text

  mediaId String?
  media   Media? @relation(fields: [mediaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([sortOrder])
}

model Testimonial {
  id        String  @id @default(cuid())
  sortOrder Int     @default(0)
  published Boolean @default(true)

  name  String
  role  String
  quote String @db.Text

  mediaId String?
  media   Media? @relation(fields: [mediaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([sortOrder])
}

enum TestimonialSubmissionStatus {
  pending
  approved
  rejected
}

model TestimonialSubmission {
  id     String @id @default(cuid())
  status TestimonialSubmissionStatus @default(pending)
  read   Boolean @default(false)

  name  String
  role  String
  email String
  phone String?
  quote String @db.Text

  createdAt DateTime @default(now())

  @@index([status])
  @@index([read])
  @@index([createdAt])
}

//
// =======================
// JOIN / MEMBERSHIP FLOW
// =======================
//

model JoinStep {
  id        String  @id @default(cuid())
  sortOrder Int     @default(0)
  published Boolean @default(true)

  stepKey     String
  title       String
  description String

  mediaId String?
  media   Media? @relation(fields: [mediaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([sortOrder])
}

model JoinPageHeader {
  id String @id @default(cuid())

  key String @unique @default("join_page_header")

  eyebrow  String @default("Membership")
  title    String
  subtitle String

  mediaId String?
  media   Media? @relation(fields: [mediaId], references: [id])

  updatedAt DateTime @updatedAt
}

//
// =======================
// NEWS / BLOG
// =======================
//

model NewsItem {
  id        String  @id @default(cuid())
  published Boolean @default(false)

  slug   String @unique
  title  String
  excerpt String
  body   String?

  authorName String?
  authorRole String?

  date DateTime

  sortOrder Int @default(0)

  mediaId String?
  media   Media? @relation(fields: [mediaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([sortOrder])
  @@index([date])
}

//
// =======================
// PUBLIC RESOURCES (VIDEOS, DOCUMENTS, LINKS)
// =======================
//

enum SocietyResourceKind {
  video
  document
  link
  other
}

model ResourcesPageSettings {
  id String @id @default("resources_page")

  eyebrow  String @default("Resources")
  headline String @default("Learning & reference materials")
  lead     String @db.Text

  updatedAt DateTime @updatedAt
}

model SocietyResource {
  id        String  @id @default(cuid())
  published Boolean @default(true)
  sortOrder Int     @default(0)

  kind        SocietyResourceKind
  title       String
  description String @db.Text
  /// Video embed URL, hosted file URL, document PDF, or external link.
  url         String?
  /// Cloudinary public_id when `url` is an uploaded file (video or document).
  urlPublicId String?

  mediaId String?
  media   Media? @relation(fields: [mediaId], references: [id])

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([kind])
  @@index([sortOrder])
  @@index([publishedAt])
}

//
// =======================
// PUBLICATIONS
// =======================
//

model Publication {
  id        String  @id @default(cuid())
  published Boolean @default(true)
  /// Highlight as the current issue on /publications.
  featured  Boolean @default(false)

  /// Full issue heading, e.g. "Vol. 51 No. 2 (2026): J. Chem. Soc. Nigeria".
  title       String
  /// Short journal name shown under the title.
  journalTitle String?
  meta        String?
  description String  @db.Text
  issue       String?
  href        String?

  publishedAt DateTime?

  sortOrder Int @default(0)

  /// Correspondence emails for readers (managed in CMS; not shown as public nav links).
  readerEmails Json @default("[]")
  /// Correspondence emails for authors (managed in CMS).
  authorEmails Json @default("[]")

  mediaId String?
  media   Media? @relation(fields: [mediaId], references: [id])

  articles PublicationArticle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([featured])
  @@index([sortOrder])
  @@index([publishedAt])
}

model PublicationArticle {
  id            String @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  published Boolean @default(true)
  sortOrder Int     @default(0)

  title   String
  authors String
  pdfHref String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicationId])
  @@index([sortOrder])
}

//
// =======================
// MEMBERSHIP APPLICATIONS & PAYMENTS
// =======================
//

enum MembershipApplicationStatus {
  pending_payment
  payment_submitted
  approved
  rejected
}

enum MembershipPaymentStatus {
  pending
  submitted
  verified
  failed
}

enum MembershipPaymentMethod {
  mobile_money_mtn
  mobile_money_telecel
  mobile_money_airteltigo
  bank_transfer
  debit_credit_card
  ussd
}

model MembershipApplication {
  id     String                      @id @default(cuid())
  status MembershipApplicationStatus @default(pending_payment)

  fullName             String
  email                String
  phone                String?
  institution          String
  jobTitle             String?
  highestDegree        String?
  declarationLegalName String
  declarationDate      String

  photoUrl      String?
  photoPublicId String?

  amountGhs         Int                     @default(250)
  paymentStatus     MembershipPaymentStatus @default(pending)
  paymentMethod     MembershipPaymentMethod?
  paystackReference String?
  payerPhone        String?
  paymentNote       String?
  paidAt            DateTime?

  memberId   String? @unique
  approvedAt DateTime?
  rejectedAt DateTime?
  adminNote  String? @db.Text

  read Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  libraryItems              MemberLibraryItem[]
  announcementDeliveries    MemberAnnouncementDelivery[]

  @@index([status])
  @@index([paymentStatus])
  @@index([read])
  @@index([createdAt])
  @@index([email])
}

/// Private link, note, or file owned by one approved member (scoped to application).
model MemberLibraryItem {
  id            String @id @default(cuid())
  applicationId String
  application   MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// link | note | file
  type String

  title String
  /// Note body, link description, or file caption
  body  String? @db.Text
  /// External URL (link) or file download URL
  url   String?
  filePublicId String?
  fileMime     String?
  fileBytes    Int?

  /// Comma-separated tags for filtering
  tags      String @default("")
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([type])
  @@index([sortOrder])
}

/// Pre-public bulletin sent to approved members (email + portal inbox).
model MemberAnnouncement {
  id String @id @default(cuid())

  title       String
  subject     String
  preview     String  @db.Text
  bodyHtml    String  @db.Text
  bodyText    String  @db.Text
  publicHref  String?
  goLiveAt    DateTime?

  // JSON-encoded array of `{ label, url, kind? }` resource attachments
  // (e.g. conference recordings, slide decks, videos, summaries). Members only.
  resourceLinks String? @db.Text

  sentAt            DateTime?
  recipientCount    Int @default(0)
  emailSuccessCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries MemberAnnouncementDelivery[]

  @@index([sentAt])
  @@index([createdAt])
}

model MemberAnnouncementDelivery {
  id             String @id @default(cuid())
  announcementId String
  applicationId  String

  announcement MemberAnnouncement      @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  application  MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  emailSent  Boolean @default(false)
  emailError String?

  readAt DateTime?

  createdAt DateTime @default(now())

  @@unique([announcementId, applicationId])
  @@index([applicationId])
  @@index([readAt])
}

//
// =======================
// MEMBER PORTAL (CMS-MANAGED)
// =======================
//

model MemberPortalSettings {
  id String @id @default("member_portal")

  dashboardEyebrow  String @default("Member area")
  dashboardTitle    String @default("Your GCS portfolio")
  dashboardLead     String @db.Text

  benefitsTitle String @default("Membership benefits")
  benefitsLead  String @db.Text

  resourcesTitle String @default("Members-only resources")
  resourcesLead  String @db.Text

  updatedAt DateTime @updatedAt
}

model MemberBenefit {
  id        String  @id @default(cuid())
  published Boolean @default(true)
  sortOrder Int     @default(0)

  /// dashboard | benefits | resources
  section     String @default("resources")
  title       String
  description String @db.Text
  body        String? @db.Text
  href        String?
  iconKey     String @default("book")
  hint        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([section])
  @@index([sortOrder])
}

/// Anonymous public site visits (for CMS analytics).
model SitePageView {
  id         String   @id @default(cuid())
  path       String
  viewedAt   DateTime @default(now())
  visitorKey String?

  @@index([viewedAt])
  @@index([visitorKey])
}