# Public site URL for canonical links, sitemap, and Open Graph (no trailing slash)
NEXT_PUBLIC_APP_URL="https://www.ghchemsoc.org"

# Google Search Console verification token (meta tag content value only)
GOOGLE_SITE_VERIFICATION=""

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="change-me"
JWT_SECRET="generate-a-long-random-string"
ADMIN_JWT_SECRET="generate-another-long-random-string"
ADMIN_OPEN_REGISTRATION="true"

CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
CLOUDINARY_NAME="your-cloud-name"
CLOUDINARY_KEY="your-api-key"
CLOUDINARY_SECRET="your-api-secret"

# Paystack
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"

# Email (SMTP is preferred when configured; Resend is used as fallback)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Ghana Chemical Society <noreply@ghchemsoc.org>"

# Optional Resend fallback (used only when SMTP is not configured)
RESEND_API_KEY="re_xxx"
MEMBERSHIP_EMAIL_FROM="Ghana Chemical Society <noreply@ghchemsoc.org>"
# EMAIL_FROM="noreply@ghchemsoc.org"
